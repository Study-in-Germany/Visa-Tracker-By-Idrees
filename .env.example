# Postgres connection (Neon / Supabase / Vercel Postgres). Use the pooled URL for DATABASE_URL, the direct one for DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Long random string used to sign login cookies (e.g. `openssl rand -base64 32`)
AUTH_SECRET=""

# First admin account created by `npm run seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""

# Optional: email notifications via Resend
RESEND_API_KEY=""
EMAIL_FROM=""

# Accommodation photos: any S3-compatible bucket (Cloudflare R2, AWS S3, Backblaze B2, Supabase Storage, MinIO).
# Required in production. In development, leaving these empty stores photos in .data/uploads.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL the bucket (or its CDN) is served from, e.g. https://pub-xxxx.r2.dev
S3_PUBLIC_URL=
# Set for non-AWS providers, e.g. https://<account>.r2.cloudflarestorage.com. Leave empty for AWS S3.
S3_ENDPOINT=
S3_REGION=auto

# Secret for the scheduled refresh (/api/cron/refresh). Vercel Cron sends it as a Bearer token.
CRON_SECRET=
